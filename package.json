{
  "name": "hardware-core-monitor",
  "displayName": "Hardware Core Monitor",
  "description": "Real-time hardware monitoring and system performance tracking directly in VSCode",
  "version": "1.0.6",
  "publisher": "HouFei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heinfy/hardware-core-monitor.git"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hardware-core-monitor",
          "title": "Hardware Monitor",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "hardware-core-monitor.sidebarView",
          "name": "Hardware Monitor",
          "icon": "resources/activitybar.svg",
          "when": "true"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hardware-core-monitor.sidebarView",
        "contents": "No hardware data available. [Start Monitoring](command:hardware-core-monitor.startMonitoring)",
        "when": "!hardwareMonitorHasData"
      }
    ],
    "commands": [
      {
        "command": "hardware-core-monitor.startMonitoring",
        "title": "Start Hardware Monitoring",
        "category": "Hardware Monitor"
      },
      {
        "command": "hardware-core-monitor.stopMonitoring",
        "title": "Stop Hardware Monitoring",
        "category": "Hardware Monitor"
      },
      {
        "command": "hardware-core-monitor.showDashboard",
        "title": "Show Hardware Dashboard",
        "category": "Hardware Monitor"
      },
      {
        "command": "hardware-core-monitor.showWebview2",
        "title": "Show Webview2 (Routed Page)",
        "category": "Hardware Monitor"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hardware-core-monitor.startMonitoring",
          "when": "view == hardware-core-monitor.sidebarView",
          "group": "navigation"
        },
        {
          "command": "hardware-core-monitor.stopMonitoring",
          "when": "view == hardware-core-monitor.sidebarView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Hardware Core Monitor",
      "properties": {
        "hardwareCoreMonitor.refreshInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "Refresh interval in milliseconds"
        },
        "hardwareCoreMonitor.enabledOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Start monitoring automatically when VSCode starts"
        },
        "hardwareCoreMonitor.cpuThreshold": {
          "type": "number",
          "default": 80,
          "description": "CPU usage warning threshold (%)"
        },
        "hardwareCoreMonitor.memoryThreshold": {
          "type": "number",
          "default": 85,
          "description": "Memory usage warning threshold (%)"
        },
        "hardwareCoreMonitor.temperatureThreshold": {
          "type": "number",
          "default": 80,
          "description": "Temperature warning threshold (°C)"
        }
      }
    }
  },
  "scripts": {
    "vsix": "pnpm dlx @vscode/vsce package",
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run build:webview && pnpm run build:webview2 && pnpm run typecheck && node esbuild.js",
    "watch": "npm-run-all -p watch:extension watch:webview watch:webview2",
    "watch:extension": "node esbuild.js --watch",
    "watch:webview": "pnpm --filter hardware-core-monitor-webview run watch",
    "dev:webview": "pnpm --filter hardware-core-monitor-webview run dev",
    "build:extension": "node esbuild.js",
    "build:webview": "pnpm --filter hardware-core-monitor-webview run build",
    "typecheck": "tsc --noEmit && pnpm --filter hardware-core-monitor-webview run typecheck && pnpm --filter hardware-core-monitor-webview2 run typecheck",
    "package": "pnpm run typecheck && pnpm run build:webview && pnpm run build:webview2 && node esbuild.js --production",
    "lint": "eslint src",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile",
    "test": "vscode-test",
    "prepare": "husky",
    "build:webview2": "pnpm --filter hardware-core-monitor-webview2 run build",
    "dev:webview2": "pnpm --filter hardware-core-monitor-webview2 run dev",
    "watch:webview2": "pnpm --filter hardware-core-monitor-webview2 run watch"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{css,scss,less,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "systeminformation": "^5.33.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.4",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.138.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.8",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.7",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.22.0"
}