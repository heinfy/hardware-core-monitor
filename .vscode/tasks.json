{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "pnpm: watch",
      "command": "pnpm run watch"
    },
    {
      "type": "shell",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": {
          "regexp": "^✘ \\[ERROR\\] (.+)$",
          "file": 1
        },
        "fileLocation": ["relative", "${workspaceFolder}"],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      },
      "label": "pnpm: watch:extension",
      "presentation": {
        "reveal": "never"
      },
      "command": "pnpm run watch:extension"
    },
    {
      "type": "shell",
      "isBackground": true,
      "problemMatcher": [],
      "label": "pnpm: watch:webview",
      "presentation": {
        "reveal": "never"
      },
      "command": "pnpm run watch:webview"
    },
    {
      "type": "shell",
      "problemMatcher": "$tsc",
      "label": "pnpm: compile",
      "group": "build",
      "command": "pnpm run compile"
    },
    {
      "type": "shell",
      "command": "pnpm run watch:webview2",
      "isBackground": true,
      "problemMatcher": [],
      "label": "pnpm: watch:webview2",
      "presentation": {
        "reveal": "never"
      }
    }
  ]
}
